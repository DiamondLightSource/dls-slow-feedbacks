[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[dev-packages]
black = "==22.3.0"
# Deprecations past this version cause issues with our code:
# https://github.com/tholo/pytest-flake8/issues/87
flake8 = "<5.0.0"

mypy = "*"
atomicwrites = "*"
typing-extensions = "*"
importlib-metadata = "*"

# List wheel here to make sure we make the same version to make wheels on gitlab and github CI
wheel = "0.33.1"

# Test and docs dependencies
mock = "*"
types-mock = "*"
pytest-cov = "*"
pytest-mypy = "*"
pytest-flake8 = "*"
pytest-black = "*"
flake8-isort = "*"
isort = ">5.0"

[packages]
# All production requirements from setup.cfg.
dls_slow_feedbacks = {editable = true, path = "."}

[scripts]
tests = "python -m pytest --cov=dls_slow_feedbacks tests"
build = "python setup.py sdist bdist_wheel"
# Delete any files that git ignore hides from us
gitclean = "git clean -fdX"
