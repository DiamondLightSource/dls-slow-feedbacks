                "debug-test"
            ],
            "console": "integratedTerminal",
        },
        {
            "name": "Python Debugger: IOC",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/dls_slow_feedbacks/__main__.py",
            "console": "integratedTerminal",
            "args": [],
            "justMyCode": true,
            "env": {
                "EPICS_CA_SERVER_PORT": "8064",
                "EPICS_CA_REPEATER_PORT": "8065",
            },
        }
    ]
