  <widget typeId="org.csstudio.opibuilder.widgets.MenuButton" version="1.0">
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <x>8</x>
    <y>600</y>
    <foreground_color>
      <color blue="128" green="0" name="Dark Blue" red="0" />
    </foreground_color>
    <background_color>
      <color blue="205" green="205" name="Controller: BG" red="205" />
    </background_color>
    <font>
      <fontdata fontName="liberation sans" height="9" style="1" />
    </font>
    <width>73</width>
    <height>25</height>
    <actions_from_pv>false</actions_from_pv>
    <name>EDM shell command</name>
    <actions hook="false" hook_all="false">
      <action type="EXECUTE_CMD">
        <command>python/tunefb_offsets.py redirect</command>
        <command_directory>$(opi.dir)</command_directory>
        <description>Forward to Quad IOCs</description>
      </action>
      <action type="EXECUTE_CMD">
        <command>python/tunefb_offsets.py reset</command>
        <command_directory>$(opi.dir)</command_directory>
        <description>Remove from Quad IOCs</description>
      </action>
      <action type="EXECUTE_CMD">
        <command>caput SR-CS-TFB-01:AGGREGATE 1</command>
        <command_directory>$(opi.dir)</command_directory>
        <description>Aggregate to Setpoints</description>
      </action>
      <action type="EXECUTE_CMD">
        <command>caput SR-CS-TFB-01:RESETCORR 1</command>
        <command_directory>$(opi.dir)</command_directory>
        <description>Zero Offsets</description>
      </action>
    </actions>
    <label>SETUP</label>
  </widget>
