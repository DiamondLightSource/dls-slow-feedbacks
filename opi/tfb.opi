      <rule name="OnOffBackgroundRule" out_exp="false" prop_id="background_color">
        <exp bool_exp="pv0==0">
          <value>
            <color blue="205" green="205" name="Controller: BG" red="205" />
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color blue="0" green="192" name="Mid Green" red="0" />
          </value>
        </exp>
        <pv trig="true">SR-CS-TFB-01:ONOFF</pv>
      </rule>
    </rules>
