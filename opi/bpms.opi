        </exp>
        <exp bool_exp="pvSev0==2">
          <value>
            <color name="Minor"/>
          </value>
        </exp>
        <pv trig="true">SR17C-DI-EBPM-05:CF:ENABLED_S</pv>
      </rule>
    </rules>
    <transparent>false</transparent>
    <visible>true</visible>
    <width>21</width>
    <x>412</x>
    <y>251</y>
