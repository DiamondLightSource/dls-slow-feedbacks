  <widget typeId="org.csstudio.opibuilder.widgets.Rectangle" version="1.0">
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <line_width>1</line_width>
    <x>197</x>
    <y>288</y>
    <width>23</width>
    <height>23</height>
    <name>EDM Rectangle</name>
    <line_color>
      <color blue="0" green="0" name="Black" red="0" />
    </line_color>
    <transparent>false</transparent>
    <background_color>
      <color blue="0" green="255" red="0" />
    </background_color>
    <rules>
      <rule name="background_color_vacStatus" out_exp="false" prop_id="background_color">
        <exp bool_exp="pv0&gt;=0 &amp;&amp; pv0&lt;1">
          <value>
            <color blue="0" green="255" name="Green" red="0" />
          </value>
        </exp>
        <exp bool_exp="pv0&gt;=1">
          <value>
            <color blue="0" green="0" name="Red" red="255" />
          </value>
        </exp>
        <pv trig="true">SR-CS-RFFB-01:EMATRIX</pv>
      </rule>
    </rules>
    <visible>true</visible>
    <line_style>0</line_style>
  </widget>
